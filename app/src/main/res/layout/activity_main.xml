<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/sampleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Native C++ AAudio Player"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnVolUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volume Up (+10%)" />

    <Button
        android:id="@+id/btnVolDown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volume Down (-10%)" />

    <Button
        android:id="@+id/btnMute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toggle Mute" />

    <Button
        android:id="@+id/btnSwitchStation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Switch Radio Station"
        android:layout_marginTop="16dp" />

</LinearLayout>